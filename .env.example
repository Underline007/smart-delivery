# Copy to .env.local and fill in values from Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Domain used to turn a phone number into the internal login email.
# Must match LOGIN_EMAIL_DOMAIN of the admin-users Edge Function.
VITE_LOGIN_EMAIL_DOMAIN=phone.smart-delivery.invalid
